# ==============================================================================
# CALZY ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env or .env.local for your local development setup:
#    cp .env.example frontend/.env.local
#    cp .env.example backend/.env
# 2. Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Next.js)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Managed PostgreSQL (Required in Phase 2)
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ------------------------------------------------------------------------------
# Backend Environment Variables (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (Direct connection URL from Supabase Settings -> Database)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# External Nutrition Data (Required in Phase 4)
# Free registration at: https://api.data.gov/signup/
USDA_API_KEY=your-usda-fooddata-central-api-key
